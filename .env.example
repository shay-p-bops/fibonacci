# Fibonacci server
PORT=4173
HOST=127.0.0.1

# OpenCode executable and optional model selection.
# Leave OPENCODE_MODEL empty to use your normal OpenCode default.
OPENCODE_BIN=opencode
OPENCODE_MODEL=
OPENCODE_AGENT=
OPENCODE_VARIANT=
OPENCODE_TIMEOUT_MS=1800000

# Folder created inside the selected repository.
AUDIT_OUTPUT_DIR=Audit Outputs

# Optional: JSON array of additional CLI arguments, for example ["--print-logs"].
OPENCODE_EXTRA_ARGS_JSON=[]

# Development-only fallback. Set true to test the UI without invoking OpenCode.
FIBONACCI_MOCK_OPENCODE=false
